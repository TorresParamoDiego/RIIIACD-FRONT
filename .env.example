# Copia este archivo como .env.local para modificar el comportamiento en desarrollo.

# "false" oculta los integrantes e instituciones demostrativos del directorio.
VITE_SHOW_DEMO_DATA=true

# URL base de la futura API. Vacía = datos locales de src/data.
VITE_API_BASE_URL=

# Retardo simulado (ms) de las solicitudes locales, para visualizar estados de carga.
VITE_MOCK_LATENCY_MS=350
